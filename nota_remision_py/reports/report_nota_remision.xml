<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Template QWeb minimo requerido por ir.actions.report.
        El PDF real se genera con ReportLab desde action_print_remision().
    -->
    <template id="report_nota_remision_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <p>Nota de Remision generada por ReportLab.</p>
                </div>
            </t>
        </t>
    </template>
    <record id="action_report_nota_remision" model="ir.actions.report">
        <field name="name">Nota de Remision</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nota_remision_py.report_nota_remision_document</field>
        <field name="report_file">nota_remision_py.report_nota_remision_document</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <!-- Sin binding_model_id para que NO aparezca en el menu Print -->
    </record>
</odoo>
