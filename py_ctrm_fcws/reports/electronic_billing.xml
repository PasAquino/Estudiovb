										</t>
									</td>
									<td colspan="2" style="text-align: right; padding-right: 5px;">
										<t t-if="o.currency_id.name =='PYG'">
											<span
												t-esc="'{0:,.0f}'.format(totalennumero).replace(',', '.')" />
										</t>
										<t t-else="">
