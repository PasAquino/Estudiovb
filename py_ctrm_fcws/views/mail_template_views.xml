<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_electronic_invoice" model="mail.template">
            <field name="name">Documento Electrónico: Envío</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang or 'es_ES' }}</field>
            <field name="subject">{{ object.company_id.name }} Documento Electrónico N° {{ object.name or 'N/A' }}</field>

            <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:13px;font-family:Arial,Helvetica,sans-serif;color:#222;">
    <p>Hola <t t-out="object.partner_id.name or ''"/>,</p>
    <p>
        Tu <strong>Documento Electrónico N° <t t-out="object.name or ''"/></strong> de
        <strong><t t-out="object.company_id.name or ''"/></strong>
        (emitida el
        <strong><t t-out="(object.invoice_date or object.create_date).strftime('%d-%m-%Y')"/></strong>)
        ya está lista.
    </p>
    <p>Puedes descargarlo en formato PDF desde el adjunto de este correo.</p>
    <p><strong>¡Gracias por tu preferencia!</strong></p>
</div>
            </field>

            <field name="report_template" ref="py_ctrm_fcws.action_report_electronic_billing"/>
            <field name="report_name">Documento_Electronico_{{ (object.name or '').replace('/','_') }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
