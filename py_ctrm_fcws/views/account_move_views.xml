<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fcws" model="ir.ui.view">
        <field name="name">account.move.form.fcws</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="fcws_tipo_transaccion" class="o_light_label"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Documento Electrónico (FCWS)">
                    <group>
                        <group>
                            <field name="fcws_state" widget="statusbar"/>
                            <field name="fcws_cdc"/>
                            <field name="fcws_qr_code"/>
                            <field name="fcws_message"/>
                            <field name="fcws_document_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="fcws_qr_image" widget="image" style="width:200px; height:200px"/>
                        </group>
                    </group>


                    <group string="Documento asociado" attrs="{'invisible': [('move_type', '!=', 'out_refund')]}">
                        <group>
                            <field name="fcws_manual_doc_asociado"/>
                        </group>
                        <group attrs="{'invisible': [('fcws_manual_doc_asociado', '!=', True)]}">
                            <field name="fcws_manual_timbrado"/>
                            <field name="fcws_manual_establecimiento"/>
                            <field name="fcws_manual_punto_expedicion"/>
                            <field name="fcws_manual_numero"/>
                            <field name="fcws_manual_fecha_emision"/>
                        </group>
                    </group>

                    <separator string="Acciones" colspan="2"/>

                    <group>
                        <button name="action_send_fcws"
                                string="Enviar a FCWS"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('fcws_state', 'not in', ('draft', 'pending', 'rejected', 'error'))]}"/>

                        <button name="action_consult_fcws"
                                string="Consultar Estado"
                                type="object"
                                class="btn-secondary"
                                attrs="{'invisible': ['|', ('fcws_cdc', '=', False), ('fcws_state', 'not in', ('draft', 'pending', 'sent', 'canceling'))]}"/>

                        <button name="%(py_ctrm_fcws.action_fcws_cancel_wizard)d"
                                string="Cancelar en FCWS"
                                type="action"
                                class="btn-danger"
                                attrs="{'invisible': [('fcws_state', 'not in', ('approved', 'rejected'))]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_fcws" model="ir.ui.view">
        <field name="name">account_move.tree.inherit.fcws</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="fcws_state"
                       widget="badge"
                       optional="show"
                       decoration-info="fcws_state in ['pending', 'sent']"
                       decoration-success="fcws_state == 'approved'"
                       decoration-danger="fcws_state in ['error', 'rejected']"
                       decoration-warning="fcws_state in ['canceling']"
                       decoration-muted="fcws_state in ['cancelled', 'disabled']"/>
            </xpath>
        </field>
    </record>
</odoo>
