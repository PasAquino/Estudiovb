<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_vat.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_py_operation_type"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Documento Electrónico (FCWS)">
                    <group>
                        <field name="sifen_has_constancia"/>
                        <field name="sifen_constancia_type"
                            attrs="{'invisible': [('sifen_has_constancia', '=', False)], 'required': [('sifen_has_constancia', '=', True)]}"/>
                    </group>
                    <group string="Datos de la constancia"
                        attrs="{'invisible': [('sifen_has_constancia', '=', False)]}">
                        <group>
                            <field name="sifen_constancia_number"
                                attrs="{'required': [('sifen_has_constancia', '=', True)]}"/>
                            <field name="sifen_constancia_control"
                                attrs="{'required': [('sifen_has_constancia', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="sifen_constancia_date_start"
                                attrs="{'required': [('sifen_has_constancia', '=', True)]}"/>
                            <field name="sifen_constancia_date_end"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
