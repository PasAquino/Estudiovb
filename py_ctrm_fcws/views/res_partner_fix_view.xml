<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fix for invalid <bold><button> in account.view_partner_property_form -->
    <record id="view_partner_property_form_fix" model="ir.ui.view">
        <field name="name">res.partner.property.form.fix.bank.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(., 'One or more Bank Accounts set on this partner')]" position="replace">
                <div groups="account.group_account_invoice,account.group_account_readonly"
                     class="alert alert-warning"
                     role="alert"
                     invisible="duplicated_bank_account_partners_count == 0">
                    One or more Bank Accounts set on this partner are also used by other
                    <button class="btn btn-link p-0"
                            type="object"
                            name="action_view_partner_with_same_bank"
                            string="Partners"/>
                    . Please make sure that this is a wanted behavior.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
