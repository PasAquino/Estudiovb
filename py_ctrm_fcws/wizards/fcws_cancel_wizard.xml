<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del wizard -->
    <record id="view_fcws_cancel_wizard_form" model="ir.ui.view">
        <field name="name">fcws.cancel.wizard.form</field>
        <field name="model">fcws.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancelar Documento Electrónico">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="cancel_reason" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel"
                            string="Confirmar Cancelación"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de apertura del wizard -->
    <record id="action_fcws_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancelar Documento FCWS</field>
        <field name="res_model">fcws.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
