<odoo>
    <template id="nota_remision_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <link rel="stylesheet" href="/maqsuppy_formatos/static/src/css/nota_remision.css"/>
                    <div class="page">
                        <div class="contenedor">
                            <table class="tabla">
                                <thead>
                                    <tr>
                                        <th style="width: 650px; height: 150px">
                                            <div style="border: 1px solid black; border-radius: 15px; height: 150px">
                                                <table class="tabla">
                                                    <tbody>
                                                        <tr style="vertical-align: middle">
                                                            <td style="width: 180px">
                                                                <img t-att-src="'data:image/png;base64,%s' % to_text(o.company_id.logo)"
                                                                     style="width: unset; max-width: 150px; max-height: 130px; padding-left: 20px; padding-top: 20px"/>
                                                            </td>
                                                            <td style="width: 420px">
                                                                <span style="font-weight: normal; padding-top: 30px">
                                                                    MAQSUPPLY
                                                                </span>
                                                                <br/>
                                                                <span style="font-size:12px">
                                                                    DongFang Bridge Paraguay S.A.
                                                                </span>
                                                                <br/>
                                                                <span style="font-weight: normal">
                                                                    América c/ Tuyutí
                                                                </span>
                                                                <br/>
                                                                <span style="font-weight: normal">
                                                                    Luque (Central), Paraguay
                                                                </span>
                                                                <br/>
                                                                <span style="font-weight: normal">
                                                                    RUC: 80085421-7
                                                                </span>
                                                                <br/>
                                                                <span>Tel:</span>
                                                                <span style="font-weight: normal">(595) 983 918 510
                                                                </span>
                                                                <br/>
                                                                <span style="font-weight: normal">
                                                                    ventas@maqsupply.com
                                                                </span>
                                                                <br/>
                                                                <span style="font-weight: normal">
                                                                    www.maqsupply.com
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </th>
                                        <th style="width: 10px">
                                            <span>&amp;nbsp;&amp;nbsp;</span>
                                        </th>
                                        <th style="width: 330px; height: 140px">
                                            <div style="border: 1px solid black; border-radius: 15px; height: 150px">
                                                <table class="tabla">
                                                    <tbody>
                                                        <tr style="width: 90px">
                                                            <td style="text-align: center">
                                                                <br/>
                                                                <br/>
                                                                <span style="font-size: 14px">
                                                                    NOTA DE ENTREGA
                                                                </span>
                                                                NRO:
                                                                <span style="font-size: 14px" t-field="o.name"/>
                                                                <br/>
                                                                <br/>
                                                                <span style="font-size: 14px">
                                                                    FECHA:
                                                                </span>
                                                                <t t-if="o.date_done">
                                                                    <span t-esc="o.date_done.strftime('%d/%m/%Y')"/>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                            <br/>
                            <div style="border: 1px solid black; border-radius: 15px; height: 110px">
                                <table class="tabla">
                                    <thead>
                                        <tr style="vertical-align: middle">
                                            <th style="width: 480px">
                                                <br/>
                                                <span style="padding-left: 16px">Señor/es</span>
                                                <br/>
                                                <span style="padding-left: 20px">Empresa:</span>
                                                <span style="font-weight: normal"
                                                      t-field="o.partner_id.name"/>
                                                <br/>
                                                <span style="padding-left: 20px">Dirección:</span>
                                                <span style="font-weight: normal"
                                                      t-field="o.partner_id.street"/>
                                                <br/>
                                                <span style="padding-left: 20px">RUC:</span>
                                                <span style="font-weight: normal"
                                                      t-field="o.partner_id.vat"/>
                                                <br/>
                                            </th>
                                            <th style="width: 420px">
                                                <br/>
                                                <br/>
                                                Teléfono:
                                                <t t-if="o.partner_id.phone">
                                                    <span style="font-weight: normal"
                                                          t-field="o.partner_id.phone"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="font-weight: normal"
                                                          t-field="o.partner_id.mobile"/>
                                                </t>
                                                <br/>
                                                Email:
                                                <span style="font-weight: normal"
                                                      t-field="o.partner_id.email"/>
                                                <br/>
                                                Departamento:
                                                <span style="font-weight: normal"
                                                      t-field="o.partner_id.state_id.name"/>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <br/>
                            <div style="border: 1px solid black; border-radius: 15px; padding: 15px;">
                                <table class="tabla" style="border: 1px solid black">
                                    <thead>
                                        <tr style="text-align: center">
                                            <th style="border: 1px solid black">
                                                Nº
                                            </th>
                                            <th style="border: 1px solid black">
                                                Descripción
                                            </th>
                                            <th style="border: 1px solid black">
                                                Condición
                                            </th>
                                            <th style="border: 1px solid black">
                                                Nº de Parte
                                            </th>
                                            <th style="border: 1px solid black">
                                                Cant.
                                            </th>
                                            <th style="border: 1px solid black">
                                                P. Uni.
                                            </th>
                                            <th style="border: 1px solid black">
                                                P. Total
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="amount_total" t-value="0"/>
                                        <t t-set="total_filas" t-value="23"/>
                                        <t t-set="filas" t-value="0"/>
                                        <t t-foreach="o.move_ids_without_package" t-as="eca">
                                            <t t-set="filas" t-value="filas + 1"/>
                                            <tr>
                                                <td style="border: 1px solid black; text-align: center">
                                                    <span t-esc="filas"/>
                                                </td>
                                                <td style="border: 1px solid black; text-align: center">
                                                    <span t-field="eca.product_id.name"/>
                                                </td>
                                                <td style="border: 1px solid black; text-align: center">
                                                    <span>ORIGINAL</span>
                                                </td>
                                                <td style="border: 1px solid black; text-align: center">
                                                    <span t-field="eca.product_id.default_code"/>
                                                </td>
                                                <td style="border: 1px solid black; text-align: center">
                                                    <span t-esc="'{0:,.2f}'.format(eca.quantity_done).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </td>
                                                <td style="border: 1px solid black; text-align: right">
                                                    <span t-esc="'{0:,.2f}'.format(eca.product_id.lst_price).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </td>
                                                <td style="border: 1px solid black; text-align: right">
                                                    <span t-esc="'{0:,.2f}'.format(eca.quantity_done * eca.product_id.lst_price).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                    <t t-set="amount_total"
                                                       t-value="amount_total + (eca.quantity_done * eca.product_id.lst_price)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-set="total_filas" t-value="total_filas - filas"/>
                                        <t t-foreach="total_filas" t-as="h">
                                            <tr>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                                <td style="border: 1px solid black">
                                                    <span>&amp;nbsp;</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="6"
                                                style="border: 1px solid black; text-align: center">
                                                <span style="font-size: 14px; font-weight: bold">TOTAL</span>

                                            </td>
                                            <td style="border: 1px solid black; text-align: right">
                                                <span t-esc="'{0:,.2f}'.format(amount_total).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <br/>
                            <div style="border: 1px solid black; border-radius: 15px; padding: 15px">
                                <span style="font-size: 17px; font-weight: bold">Observaciones</span>
                                <br/>
                                <span t-field="o.note"/>
                            </div>
                            <br/>
                            <br/>
                            <br/>
                            <br/>
                            <table class="tabla" width="100%">
                                <thead>
                                    <tr>
                                        <th colspan="2">
                                            <span>DATOS DEL RECEPTOR</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th colspan="2">
                                            <span>NOMBRE:</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th style="width: 500px">
                                            <span>CI:</span>
                                        </th>
                                        <th>
                                            <span>FIRMA Y SELLO:</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th colspan="2">
                                            <span>FECHA</span>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
