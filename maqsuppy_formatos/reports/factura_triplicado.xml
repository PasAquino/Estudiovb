<odoo>
    <template id="template_factura_duplicado">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <link rel="stylesheet" href="/tecnum_formatos/static/src/css/factura.css"/>
                    <t t-foreach="3" t-as="index">
                        <div class="page">
                            <div class="contenedor">
                                <table class="tabla" style="border: 1px solid black">
                                    <thead>
                                        <tr>
                                            <th style="width: 200px" rowspan="2">
                                                <img t-att-src="'data:image/png;base64,%s' % to_text(o.company_id.logo)"
                                                     style="width: unset; max-width: 190px; max-height: 120px; padding-left: 20px"/>
                                            </th>
                                            <th style="width: 470px" rowspan="2">
                                                <span style="font-weight: bold; font-size: 16px">
                                                    <span t-field="o.company_id.name"/>
                                                </span>
                                                <br/>
                                                <span style="font-weight: normal">
                                                    RUC:
                                                    <span t-field="o.company_id.vat"/>
                                                </span>
                                                <br/>
                                                <span style="font-weight: normal">
                                                    <span t-field="o.company_id.street"/>
                                                    <span t-field="o.company_id.street2"/>
                                                    -
                                                    <span t-field="o.company_id.city"/>
                                                    -
                                                    <span t-field="o.company_id.country_id.name"/>
                                                </span>
                                                <br/>
                                                <span style="font-weight: normal">
                                                    <span t-field="o.company_id.phone"/>
                                                </span>
                                                <br/>
                                                <span style="font-weight: normal">
                                                    <span t-field="o.company_id.email"/>
                                                </span>
                                                <br/>
                                                <span style="font-weight: normal">
                                                    <span t-field="o.company_id.website"/>
                                                </span>
                                            </th>
                                            <th style="width: 140px">
                                                <span>Timbrado Nº</span>
                                                <br/>
                                                <span>Inicio Vigencia:</span>
                                                <br/>
                                                <span>Fin Vigencia:</span>
                                            </th>
                                            <th style="width: 110px">
                                                <span style="font-weight: normal" t-field="o.timbrado_id.name"/>
                                                <br/>
                                                <span style="font-weight: normal"
                                                      t-field="o.timbrado_id.date_range_ini"/>
                                                <br/>
                                                <span style="font-weight: normal"
                                                      t-field="o.timbrado_id.date_range_end"/>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th colspan="2" style="text-align: center">
                                                <span style="font-size: 18px">Factura</span>
                                                <br/>
                                                <span style="font-size: 20px" t-field="o.name"/>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                                <br/>
                                <table class="tabla" style="border: 1px solid black">
                                    <thead>
                                        <tr style="height: 20px">
                                            <th style="width: 200px">
                                                <span style="padding-left: 15px">Fecha</span>
                                            </th>
                                            <th style="width: 420px">
                                                <t t-if="o.invoice_date">
                                                    <span style="font-weight: normal"
                                                          t-esc="o.invoice_date.strftime('%d-%m-%Y')"/>
                                                </t>
                                            </th>
                                            <th style="width: 170px">
                                                <span>Condición de Venta:</span>
                                            </th>
                                            <th style="width: 160px">
                                                <t t-if="o.invoice_date == o.invoice_date_due">
                                                    <span style="font-weight: normal">CONTADO</span>
                                                </t>
                                                <t t-if="not o.invoice_date == o.invoice_date_due">
                                                    <span style="font-weight: normal">CRÉDITO</span>
                                                </t>
                                            </th>
                                        </tr>
                                        <tr style="height: 20px">
                                            <th>
                                                <span style="padding-left: 15px">Nombre o Razón Social:</span>
                                            </th>
                                            <th>
                                                <span style="font-weight: normal" t-field="o.partner_id.name"/>
                                            </th>
                                            <th>
                                                RUC:
                                            </th>
                                            <th>
                                                <span style="font-weight: normal" t-field="o.partner_id.vat"/>
                                            </th>
                                        </tr>
                                        <tr style="height: 20px">
                                            <th>
                                                <span style="padding-left: 15px">Dirección:</span>
                                            </th>
                                            <th>
                                                <span style="font-weight: normal" t-field="o.partner_id.street"/>
                                            </th>
                                            <th>
                                                <span>Teléfono:</span>
                                            </th>
                                            <th>
                                                <t t-if="o.partner_id.phone">
                                                    <span style="font-weight: normal" t-field="o.partner_id.phone"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="font-weight: normal"
                                                          t-field="o.partner_id.mobile"/>
                                                </t>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                                <br/>
                                <table class="tabla">
                                    <thead>
                                        <tr>
                                            <th rowspan="2" style="text-align: center; border: 1px solid black; width: 120px">
                                                <span>CÓDIGO</span>
                                            </th>
                                            <th rowspan="2" style="text-align: center; border: 1px solid black; width: 300px">
                                                <span>CONCEPTO</span>
                                            </th>
                                            <th rowspan="2" style="text-align: center; border: 1px solid black; width: 120px">
                                                <span>PRECIO</span>
                                            </th>
                                            <th rowspan="2" style="text-align: center; border: 1px solid black; width: 100px">
                                                <span>CANTIDAD</span>
                                            </th>
                                            <th colspan="3" style="text-align: center; border: 1px solid black">
                                                <span>SUB-TOTALES</span>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th style="text-align: center; border: 1px solid black; width: 120px">
                                                <span>EXENTO</span>
                                            </th>
                                            <th style="text-align: center; border: 1px solid black; width: 100px">
                                                <span>5%</span>
                                            </th>
                                            <th style="text-align: center; border: 1px solid black; width: 120px">
                                                <span>10%</span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="subtotalexenta1" t-value="0"/>
                                        <t t-set="subtotalcinco1" t-value="0"/>
                                        <t t-set="subtotaldiez1" t-value="0"/>
                                        <t t-set="filas" t-value="0"/>
                                        <t t-foreach="o.invoice_line_ids" t-as="eca">
                                            <t t-set="fila" t-value="0"/>
                                            <tr>
                                                <t t-if="not eca.display_type">
                                                    <td style="text-align: center; border: 1px solid black">
                                                        <span t-field="eca.product_id.default_code"/>
                                                    </td>
                                                    <td style="border: 1px solid black">
                                                        <t t-set="producto" t-value="1"/>
                                                        <span t-esc="eca.product_id.name" t-options="{'widget': 'text'}"/>
                                                    </td>
                                                    <td style="text-align: center; border: 1px solid black">
                                                        <t t-if="o.currency_id.name =='PYG'">
                                                            <span t-esc="'{0:,.0f}'.format((eca.price_total/eca.quantity)).replace(',', '.')"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-esc="'{0:,.2f}'.format((eca.price_total/eca.quantity)).replace('.','b').replace('a','.').replace('b',',')"/>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: center; border: 1px solid black">
                                                        <t t-if="o.currency_id.name =='PYG'">
                                                            <span t-esc="'{0:,.0f}'.format(eca.quantity).replace(',', '.')"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-esc="'{0:,.2f}'.format(eca.quantity).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: right; border: 1px solid black">
                                                        <t t-if="not eca.tax_5 and not eca.tax_10">
                                                            <t t-if="o.currency_id.name == 'PYG'">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.0f}'.format(eca.price_total).replace(',', '.')"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.2f}'.format(eca.price_total).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                            </t>
                                                            <t t-set="subtotalexenta1" t-value="subtotalexenta1 + eca.price_total"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="padding-right: 10px">0</span>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: right; border: 1px solid black">
                                                        <t t-if="eca.tax_5">
                                                            <t t-if="o.currency_id.name =='PYG'">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.0f}'.format(eca.price_total).replace(',', '.')"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.2f}'.format(eca.price_total).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                            </t>
                                                            <t t-set="subtotalcinco1" t-value="subtotalcinco1 + eca.price_total"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="padding-right: 10px">0</span>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: right; border: 1px solid black">
                                                        <t t-if="eca.tax_10">
                                                            <t t-if="o.currency_id.name =='PYG'">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.0f}'.format(eca.price_total).replace(',', '.')"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span style="padding-right: 10px"
                                                                      t-esc="'{0:,.2f}'.format(eca.price_total).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                            </t>
                                                            <t t-set="subtotaldiez1"
                                                               t-value="subtotaldiez1 + eca.price_total"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="padding-right: 10px">0</span>
                                                        </t>
                                                    </td>
                                                </t>
                                                <t t-if="eca.display_type == 'line_section'">
                                                    <td>&amp;nbsp;&amp;nbsp;</td>
                                                    <td name="td_section_line" colspan="99">
                                                        <span t-field="eca.name"/>
                                                    </td>
                                                </t>

                                                <t t-if="eca.display_type == 'line_note'">
                                                    <td>&amp;nbsp;&amp;nbsp;</td>
                                                    <td name="td_note_line" colspan="99">
                                                        <span t-field="eca.name"/>
                                                    </td>
                                                </t>

                                            </tr>
                                        </t>

                                        <tr style="height: 25px">
                                            <td colspan="4"
                                                style="font-weight:bold; border: 1px solid black; text-align: right">
                                                <span style="padding-right: 10px">SUB-TOTALES:</span>
                                            </td>
                                            <td style="text-align:right; border: 1px solid black;">
                                                <t t-if="o.currency_id.name =='PYG'">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.0f}'.format(subtotalexenta1).replace(',', '.')"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.2f}'.format(subtotalexenta1).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </t>
                                            </td>
                                            <td style="text-align:right; border: 1px solid black;">
                                                <t t-if="o.currency_id.name =='PYG'">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.0f}'.format(subtotalcinco1).replace(',', '.')"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.2f}'.format(subtotalcinco1).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </t>
                                            </td>
                                            <td style="text-align:right; border: 1px solid black;">
                                                <t t-if="o.currency_id.name =='PYG'">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.0f}'.format(subtotaldiez1).replace(',', '.')"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.2f}'.format(subtotaldiez1).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <t t-set="totalennumero" t-value="0"/>
                                        <t t-set="totalennumero" t-value="totalennumero + subtotalexenta1"/>
                                        <t t-set="totalennumero" t-value="totalennumero + subtotalcinco1"/>
                                        <t t-set="totalennumero" t-value="totalennumero + subtotaldiez1"/>
                                        <tr style="height: 25px">
                                            <th colspan="6" style="text-align:right; border: 1px solid black;">
                                                <span style="font-weight:bold; padding-right: 10px">TOTAL A PAGAR
                                                </span>
                                            </th>
                                            <th style="text-align:right; border: 1px solid black;">
                                                <t t-if="o.currency_id.name =='PYG'">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.0f}'.format(totalennumero).replace(',', '.')"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="padding-right: 10px"
                                                          t-esc="'{0:,.2f}'.format(totalennumero).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                                </t>
                                            </th>
                                        </tr>
                                        <tr style="height: 25px">
                                            <th colspan="7" style="text-align: left; border: 1px solid black;">
                                                <span style="font-weight:bold; padding-left: 10px">TOTAL A PAGAR EN
                                                    LETRAS:
                                                </span>
                                                <span style="font-weight: normal"
                                                      t-esc="o.currency_id.currency_unit_label+' '+o.generar_texto(o.amount_total,o.currency_id.id)"/>
                                            </th>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="tabla" style="border: 1px solid black">
                                    <t t-set="iva5t" t-value="0"/>
                                    <t t-set="iva10t" t-value="0"/>
                                    <t t-set="ivasuma" t-value="0"/>
                                    <t t-set="iva5t" t-value="subtotalcinco1 / 21"/>
                                    <t t-set="iva10t" t-value="subtotaldiez1 / 11"/>
                                    <t t-set="ivasuma" t-value="iva5t + iva10t"/>
                                    <tr style="height: 25px">
                                        <th style="text-align:left; width: 220px">
                                            <span style="padding-left: 10px">LIQUIDACIÓN DEL IVA:</span>
                                        </th>
                                        <th style="text-align:left; width: 120px">(5%)</th>
                                        <th style="width: 120px; font-weight:normal">
                                            <t t-if="o.currency_id.name =='PYG'">
                                                <span t-esc="'{0:,.0f}'.format(round(iva5t)).replace(',', '.')"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="'{0:,.2f}'.format(round(iva5t)).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                            </t>
                                        </th>
                                        <th style="text-align:left; width: 120px">(10%)</th>
                                        <th style="width: 120px; font-weight:normal">
                                            <t t-if="o.currency_id.name =='PYG'">
                                                <span t-esc="'{0:,.0f}'.format(round(iva10t)).replace(',', '.')"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="'{0:,.2f}'.format(round(iva10t)).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                            </t>
                                        </th>
                                        <th style="text-align:left; width: 120px">TOTAL IVA:</th>
                                        <th style="width: 120px; font-weight:normal">
                                            <t t-if="o.currency_id.name =='PYG'">
                                                <span t-esc="'{0:,.0f}'.format(round(ivasuma)).replace(',', '.')"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="'{0:,.2f}'.format(round(ivasuma)).replace(',','a').replace('.','b').replace('a','.').replace('b',',')"/>
                                            </t>
                                        </th>
                                    </tr>
                                </table>
                                <span style="font-size: 11px">Autorización de Autoimpresor y Timbrado de Documentos
                                    Nº 350010019368
                                </span>
                                <br/>
                                <t t-if="index == 0">
                                    <span style="font-size: 11px">Original: Cliente</span>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <table class="tabla">
                                        <thead>
                                            <tr>
                                                <th style="text-align: center; width: 290px">
                                                    ------------------------------
                                                </th>
                                                <th style="text-align: center; width: 290px">
                                                    ------------------------------
                                                </th>
                                                <th style="text-align: center; width: 290px">
                                                    ------------------------------
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: center">Firma</td>
                                                <td style="text-align: center">Aclaración</td>
                                                <td style="text-align: center">Fecha</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p style="page-break-after:always;"/>
                                </t>
                                <t t-elif="index == 1">
                                    <span style="font-size: 11px">Duplicado: Empresa</span>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <table class="tabla">
                                        <thead>
                                            <tr>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: center">Firma</td>
                                                <td style="text-align: center">Aclaración</td>
                                                <td style="text-align: center">Fecha</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p style="page-break-after:always;"/>
                                </t>
                                <t t-elif="index == 2">
                                    <span style="font-size: 11px">Triplicado: Archivo Tributario</span>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <table class="tabla">
                                        <thead>
                                            <tr>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                                <th style="text-align: center; width: 260px">
                                                    -----------------------
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="text-align: center">Firma</td>
                                                <td style="text-align: center">Aclaración</td>
                                                <td style="text-align: center">Fecha</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>

                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
