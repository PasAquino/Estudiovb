<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_type_search_form_view" model="ir.ui.view">
        <field name="name">product.type.search.form</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <search string="Product Type">
                <field name="name"/>
            </search>
        </field>
    </record>

    <act_window
            id="action_open_type_products"
            name="Type Products"
            res_model="product.template"
            view_mode="kanban,form,tree"
            domain="[('product_type_id', '=', active_id)]"/>

    <act_window
            id="action_open_single_product_type"
            name="Product type"
            res_model="product.type"
            view_mode="kanban,form,tree"
            target="current"
            domain="[('product_ids', 'in', active_id)]"/>

    <record id="view_product_type_form" model="ir.ui.view">
        <field name="name">product.type.form</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_open_type_products)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="products_count" widget="statinfo"
                                   string="Products"
                                   context="{'default_product_type_id': active_id}"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Type Name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_type_tree" model="ir.ui.view">
        <field name="name">product.type.tree</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <tree string="product.type">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_product_type_kanban" model="ir.ui.view">
        <field name="name">product.type.kanban</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="logo"/>
                <field name="products_count"/>
                <field name="description"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.type', 'logo', record.id.raw_value)" alt="Logo"/>
                            </div>
                            <div class="oe_kanban_details">
                                <h4>
                                    <field name="name"/>
                                </h4>
                                <div>
                                    <a name="%(action_open_type_products)d" type="action">
                                        <t t-esc="record.products_count.value"/>
                                        Productos
                                    </a>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_template_search_type" model="ir.ui.view">
        <field name="name">product.template.search.type</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_type_id"/>
                <filter string="type" name="groupby_type" domain="[]"
                        context="{'group_by' : 'product_type_id'}"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_type_add" model="ir.ui.view">
        <field name="name">product.template.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="sale_ok" position="before">
                <field name="product_type_id" placeholder="Tipo"/>
                <div/>
            </field>
        </field>
    </record>

    <record id="view_product_template_kanban_type" model="ir.ui.view">
        <field name="name">product kanban view: add type</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <div>
                    <a t-if="record.product_type_id" type="action"
                       name="%(action_open_single_product_type)d">
                        <field name="product_type_id"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_product_variant_kanban_type" model="ir.ui.view">
        <field name="name">product variant kanban view: add type</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <div>
                    <a t-if="record.product_type_id" type="open">
                        <field name="product_type_id"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!--<record id="view_product_template_tree_type" model="ir.ui.view">
        <field name="name">product tree view: add type</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_type_id"/>
            </field>
        </field>
    </record>-->

    <!--<record id="view_product_variant_tree_type" model="ir.ui.view">
        <field name="name">product variant tree view: add type</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_type_id"/>
            </field>
        </field>
    </record>-->

    <record model="ir.actions.act_window" id="action_product_type">
        <field name="name">type</field>
        <field name="res_model">product.type</field>
        <field name="view_mode">kanban,form,tree</field>
    </record>

    <menuitem
            name="Tipos de Productos"
            id="menu_product_type"
            action="action_product_type"
            parent="sale.prod_config_main"/>

    <menuitem
            name="Tipos de Productos"
            id="menu_stock_product_type"
            action="action_product_type"
            parent="stock.menu_stock_config_settings"/>

</odoo>