<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_partnumber_search_form_view" model="ir.ui.view">
        <field name="name">product.partnumber.search.form</field>
        <field name="model">product.partnumber</field>
        <field name="arch" type="xml">
            <search string="Product PART#">
                <field name="name"/>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <act_window id="action_open_partnumber_products"
                name="Product PART#"
                res_model="product.template"
                view_mode="kanban,form,tree"
                domain="[('product_partnumber_id', '=', active_id)]"/>

    <act_window id="action_open_single_product_partnumber"
                name="Product PART#"
                res_model="product.partnumber"
                view_mode="kanban,form,tree"
                target="current"
                domain="[('product_ids', 'in', active_id)]"/>

    <record id="view_product_partnumber_form" model="ir.ui.view">
        <field name="name">product.partnumber.form</field>
        <field name="model">product.partnumber</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_open_partnumber_products)d" type="action" class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="products_count" widget="statinfo" string="Productos"
                                   context="{'default_product_partnumber_id': active_id}"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="PART#" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_partnumber_tree" model="ir.ui.view">
        <field name="name">product.partnumber.tree</field>
        <field name="model">product.partnumber</field>
        <field name="arch" type="xml">
            <tree string="product.partnumber">
                <field name="name"/>
                <field name="description"/>
                <field name="partner_id"/>
            </tree>
        </field>
    </record>

    <record id="view_product_partnumber_kanban" model="ir.ui.view">
        <field name="name">product.partnumber.kanban</field>
        <field name="model">product.partnumber</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="logo"/>
                <field name="products_count"/>
                <field name="description"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.partnumber', 'logo', record.id.raw_value)"
                                     alt="Logo"/>
                            </div>
                            <div class="oe_kanban_details">
                                <h4>
                                    <field name="name"/>
                                </h4>
                                <div>
                                    <a name="%(product_brand.action_open_partnumber_products)d" type="action">
                                        <t t-esc="record.products_count.value"/>
                                        Productos
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_template_search_partnumber" model="ir.ui.view">
        <field name="name">product.template.search.c1.lga</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_partnumber_id"/>
                <filter string="PART#" name="groupby_partnumber" domain="[]"
                        context="{'group_by' : 'product_partnumber_id'}"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_partnumber_add" model="ir.ui.view">
        <field name="name">product.template.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="sale_ok" position="before">
                <field name="product_partnumber_id" placeholder="PART#"/>
                <div/>
            </field>
        </field>
    </record>

    <record id="view_product_template_kanban_partnumber" model="ir.ui.view">
        <field name="name">product kanban view: add brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <div>
                    <a t-if="record.product_partnumber_id" type="action"
                       name="%(action_open_single_product_partnumber)d">
                        <field name="product_partnumber_id"/>
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_product_variant_kanban_partnumber" model="ir.ui.view">
        <field name="name">product variant kanban view: add partnumber</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <div>
                    <a t-if="record.product_partnumber_id" type="open">
                        <field name="product_partnumber_id"/>
                    </a>

                </div>
            </xpath>
        </field>
    </record>

    <!--<record id="view_product_template_tree_partnumber" model="ir.ui.view">
        <field name="name">product tree view: add partnumber</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_partnumber_id"/>

            </field>
        </field>
    </record>-->

    <!--<record id="view_product_variant_tree_partnumber" model="ir.ui.view">
        <field name="name">product variant tree view: add partnumber</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="product_partnumber_id"/>
            </field>
        </field>
    </record>-->

    <record model="ir.actions.act_window" id="action_product_partnumber">
        <field name="name">PART#</field>
        <field name="res_model">product.partnumber</field>
        <field name="view_mode">kanban,form,tree</field>
    </record>

    <menuitem
            name="PART#"
            id="menu_product_partnumber"
            action="action_product_partnumber"
            parent="sale.prod_config_main"/>

    <menuitem
            name="PART#"
            id="menu_stock_product_partnumber"
            action="action_product_partnumber"
            parent="stock.menu_stock_config_settings"/>

</odoo>