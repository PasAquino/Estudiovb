<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inherit_account_move90" model="ir.ui.view">
            <field name="name">account.move.90</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']" position="inside">
                    <field name="imputa_iva"
                           attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                    <field name="imputa_ire"
                           attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                    <field name="imputa_irp"
                           attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                    <field name="no_imputa" widget="selection"
                           attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                    <field name="factura_electronica"
                           attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="auxi_field" invisible="1"/>
                    <field name="nota_credito_asociada" invisible="1"/>
                </xpath>

            </field>
        </record>
    </data>

</odoo>
